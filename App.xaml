<Application x:Class="TVClockModern.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DialogBackground" Color="#FF2B2B2B"/>
        <!-- グローバルのTextBlockスタイルはボタン内テキストまで染めてしまうので使わない -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="Background" Value="#FF3D3D3D"/>
            <Setter Property="BorderBrush" Value="#FF777777"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#FF3A3A3A" BorderBrush="#FF555555"
                                BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                                Margin="0,0,2,0" Padding="14,6">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5A5A5A"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF474747"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
