<Window x:Class="TVClockModern.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVClock Modern - 設定"
        Width="480"
        Height="840"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource DialogBackground}"
        Foreground="#FFDDDDDD"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0" Background="Transparent" BorderBrush="#FF555555">

            <!-- ================= 書式タブ ================= -->
            <TabItem x:Name="FormatTab" Tag="format">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,8">

                        <TextBlock x:Name="lblTimeFormat" FontWeight="Bold"/>
                        <ComboBox x:Name="TimeFormatBox" IsEditable="True" Margin="0,4,0,10" SelectionChanged="OnPreviewChanged"/>

                        <TextBlock x:Name="lblDateFormat" FontWeight="Bold"/>
                        <ComboBox x:Name="DateFormatBox" IsEditable="True" Margin="0,4,0,10" SelectionChanged="OnPreviewChanged"/>
                        <CheckBox x:Name="ShowDateCheck" Margin="0,0,0,12" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged"/>

                        <TextBlock x:Name="lblTransitionEffect" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TransitionBox" Grid.Column="0"
                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectionChanged="OnPreviewChanged" Margin="0,4,0,10"/>
                            <TextBlock x:Name="lblTransitionDuration" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Slider x:Name="TransitionDurationSlider" Grid.Column="2" Minimum="50" Maximum="500" Width="140"
                                    SmallChange="10" LargeChange="100" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,10"/>
                            <TextBlock x:Name="TransitionDurationValue" Grid.Column="3" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 文字タブ ================= -->
            <TabItem x:Name="CharsTab" Tag="chars">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,8">

                        <TextBlock x:Name="lblFont" FontWeight="Bold"/>
                        <ComboBox x:Name="FontBox" Margin="0,4,0,10" SelectionChanged="OnPreviewChanged"/>

                        <TextBlock x:Name="lblFontSize" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SizeSlider" Grid.Column="0" Minimum="12" Maximum="200"
                                    SmallChange="1" LargeChange="8" IsMoveToPointEnabled="False"
                                    Margin="0,4,0,10" ValueChanged="OnPreviewChanged"/>
                            <TextBlock x:Name="SizeValue" Grid.Column="1" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="lblTextColor" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button x:Name="ColorButton" Width="80" Click="OnPickColor"/>
                            <Rectangle x:Name="ColorPreview" Width="40" Height="18" Margin="8,0,0,0" RadiusX="3" RadiusY="3"
                                       Stroke="#FF888888"/>
                        </StackPanel>

                        <TextBlock x:Name="lblLetterSpacing" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LetterSpacingSlider" Grid.Column="0" Minimum="0" Maximum="50"
                                    SmallChange="1" LargeChange="5" IsMoveToPointEnabled="False"
                                    Margin="0,4,0,10" ValueChanged="OnPreviewChanged"/>
                            <TextBlock x:Name="LetterSpacingValue" Grid.Column="1" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="lblSepSpacing" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SeparatorSpacingSlider" Grid.Column="0" Minimum="0" Maximum="200"
                                    SmallChange="1" LargeChange="10" IsMoveToPointEnabled="False"
                                    Margin="0,4,0,10" ValueChanged="OnPreviewChanged"/>
                            <TextBlock x:Name="SeparatorSpacingValue" Grid.Column="1" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 装飾タブ ================= -->
            <TabItem x:Name="DecoTab" Tag="deco">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,8">

                        <TextBlock x:Name="lblOutline" FontWeight="Bold"/>
                        <CheckBox x:Name="OutlineCheck" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="lblOutlineColor" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="OutlineColorButton" Width="80" Click="OnPickOutlineColor"/>
                                <Rectangle x:Name="OutlineColorPreview" Width="40" Height="18" Margin="8,0,0,0" RadiusX="3" RadiusY="3" Stroke="#FF888888"/>
                            </StackPanel>
                            <TextBlock x:Name="lblOutlineThickness" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="OutlineThicknessSlider" Grid.Column="1" Grid.Row="1" Minimum="0.5" Maximum="10"
                                    SmallChange="0.5" LargeChange="1" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,10"/>
                            <TextBlock x:Name="OutlineThicknessValue" Grid.Column="2" Grid.Row="1" Text="2.0" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="lblShadow" FontWeight="Bold"/>
                        <CheckBox x:Name="ShadowCheck" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="lblShadowBlur" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="ShadowBlurSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="40"
                                    SmallChange="1" LargeChange="4" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,8"/>
                            <TextBlock x:Name="ShadowBlurValue" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                            <TextBlock x:Name="lblShadowDensity" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="ShadowOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,10"/>
                            <TextBlock x:Name="ShadowOpacityValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 動作タブ ================= -->
            <TabItem x:Name="BehaviorTab" Tag="behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,8">

                        <TextBlock x:Name="lblMonitor" FontWeight="Bold"/>
                        <ComboBox x:Name="MonitorBox" Margin="0,4,0,4"/>
                        <CheckBox x:Name="AllMonitorsCheck"
                                  Margin="0,2,0,12"/>

                        <TextBlock x:Name="lblPositionPreset" FontWeight="Bold"/>
                        <WrapPanel Margin="0,4,0,4">
                            <Button x:Name="PresetTl" Width="70" Tag="topleft" Click="OnPreset" Margin="0,0,6,4"/>
                            <Button x:Name="PresetTr" Width="70" Tag="topright" Click="OnPreset" Margin="0,0,6,4"/>
                            <Button x:Name="PresetBl" Width="70" Tag="bottomleft" Click="OnPreset" Margin="0,0,6,4"/>
                            <Button x:Name="PresetBr" Width="70" Tag="bottomright" Click="OnPreset" Margin="0,0,6,4"/>
                            <Button x:Name="PresetC" Width="70" Tag="center" Click="OnPreset" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock x:Name="notePreset"
                                   FontSize="11" Foreground="#FF999999" Margin="0,0,0,12"/>

                        <TextBlock x:Name="lblWindowOpacity" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0.2" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="False"
                                    Margin="0,4,0,4" ValueChanged="OnPreviewChanged"/>
                            <TextBlock x:Name="OpacityValue" Grid.Column="1" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                        </Grid>

                        <CheckBox x:Name="TopmostCheck" Margin="0,8,0,6"/>
                        <CheckBox x:Name="ClickThroughCheck"
                                  Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,12">
                            <TextBlock x:Name="lblModifierKey" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ModifierBox" Width="110" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Margin="0,0,0,12"/>

                        <TextBlock x:Name="lblLanguage" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ComboBox x:Name="LanguageBox" Width="180" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                        </StackPanel>

                        <TextBlock x:Name="lblProximity" FontWeight="Bold"/>
                        <CheckBox x:Name="ProximityCheck" Margin="0,4,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="lblProximityDistance" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="ProximitySlider" Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="400"
                                    SmallChange="5" LargeChange="20" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,8"/>
                            <TextBlock x:Name="ProximityValue" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                            <TextBlock x:Name="lblProximityOpacity" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="ProximityOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="1"
                                    SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,8"/>
                            <TextBlock x:Name="ProximityOpacityValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                            <TextBlock x:Name="lblFadeSpeed" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                            <Slider x:Name="FadeSpeedSlider" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="10"
                                    SmallChange="1" LargeChange="1" IsMoveToPointEnabled="False"
                                    ValueChanged="OnPreviewChanged" Margin="0,4,0,10"/>
                            <TextBlock x:Name="FadeSpeedValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="lblFadeCurve" FontWeight="Bold"/>
                        <ComboBox x:Name="FadeEasingBox" SelectedValuePath="Key" DisplayMemberPath="Value"
                                  SelectionChanged="OnPreviewChanged" Margin="0,4,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 情報タブ ================= -->
            <TabItem x:Name="InfoTab" Tag="info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,8">
                        <TextBlock Text="TVClock Modern" FontSize="20" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock x:Name="lblAppDesc" Foreground="#FF999999" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="lblVersion" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBlock x:Name="VersionText" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,4"/>

                            <TextBlock x:Name="lblAuthor" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="micachi" VerticalAlignment="Center" Margin="0,4,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="GitHub" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4">
                                <Hyperlink NavigateUri="https://github.com/micachi/TVClockModern" RequestNavigate="OnNavigate">
                                    github.com/micachi/TVClockModern
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock x:Name="lblLicense" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,4">
                                <Hyperlink NavigateUri="https://github.com/micachi/TVClockModern/blob/main/LICENSE" RequestNavigate="OnNavigate">
                                    MIT License
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock x:Name="lblSettingsFile" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="%APPDATA%\TVClockModern\settings.json"
                                       Foreground="#FF999999" VerticalAlignment="Center" Margin="0,4,0,4"/>

                            <TextBlock x:Name="lblLogs" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="%LOCALAPPDATA%\TVClockModern\logs\"
                                       Foreground="#FF999999" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        </Grid>

                        <TextBlock x:Name="lblSettingsTransfer" FontWeight="Bold" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ExportButton" Width="120" Margin="0,0,8,0" Click="OnExport"/>
                            <Button x:Name="ImportButton" Width="120" Click="OnImport"/>
                        </StackPanel>
                        <TextBlock x:Name="lblSettingsSavedTo" Foreground="#FF999999" Margin="0,2,0,0"/>

                        <TextBlock x:Name="lblDisclaimer" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBlock x:Name="lblDisclaimer1" TextWrapping="Wrap" Foreground="#FF999999"/>
                        <TextBlock x:Name="lblDisclaimer2" TextWrapping="Wrap" Foreground="#FF999999" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="lblPreview" FontWeight="Bold"/>
            <Border Background="#FF111111" Padding="8" Margin="0,4,0,12" CornerRadius="4" MinHeight="80">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel x:Name="PreviewTimeHost" Orientation="Horizontal" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="PreviewDateHost" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Width="90" Margin="0,0,8,0" Click="OnOk"/>
            <Button x:Name="CancelButton" Width="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="ApplyButton" Width="90" Click="OnApply"/>
        </StackPanel>
    </Grid>
</Window>
