<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TVClockModern</RootNamespace>
    <AssemblyName>TVClockModern</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 単一exe配布用(RID を先に確定させてから PublishSingleFile を評価) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- WinForms/Drawing の暗黙 global using を無効化し、WPF との名前衝突を防ぐ -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- UI 多言語辞書: StringsData.cs (JSON から生成した C# 辞書) を使用 -->

  <!-- WFAC010(高DPI設定をマニフェストから移せという誘導)を抑制する。
       本アプリのUIは WPF であり、WPF の Per-Monitor V2 DPI は app.manifest が正規の
       構成手段。ApplicationHighDpiMode は WinForms 専用で効果がなく、
       マニフェストから dpiAware を削除するとマルチモニタで滲み・崩れが再発するため
       マニフェスト側を維持する。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>
